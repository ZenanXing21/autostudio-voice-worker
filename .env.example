MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
DATA_DIR=/workspace/autostudio
HF_HOME=/workspace/hf-cache
OUTPUT_DIR=/workspace/outputs
WORKER_MODE=pod
# Set a long random value as a RunPod secret; never commit its actual value.
API_TOKEN=
# Leave S3_BUCKET empty for local outputs; use a private bucket for remote URLs.
S3_BUCKET=
# Configure these only when S3_BUCKET is set.
S3_ENDPOINT_URL=
S3_REGION=auto
REFERENCE_HOSTS=
PRESIGN_SECONDS=3600
CHUNK_CHARS=180
MAX_TEXT_CHARS=10000
PRONUNCIATION_DICTIONARY=/app/pronunciation.json
